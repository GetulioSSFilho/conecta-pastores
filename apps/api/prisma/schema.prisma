// =============================================================================
// Plataforma Pastoral - Prisma schema
// PostgreSQL 16+
//
// Decisoes principais:
//  - UUID como PK de toda entidade de dominio.
//  - Soft delete (deletedAt) nas entidades com valor historico.
//  - Hierarquia pastoral = adjacency list (PastoralRelationship)
//    + closure table (PastoralClosure) materializada. Ver docs/database.md.
//  - Timestamps sempre em UTC (@db.Timestamptz).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum PastorStatus {
  ACTIVE // ativo
  IN_TRAINING // em treinamento
  ON_LEAVE // licenca
  SUSPENDED // afastado
  MISSIONARY // missionario
  DISMISSED // desligado
  DECEASED // falecido
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  OTHER
}

enum ChurchStatus {
  ACTIVE
  PLANTING
  INACTIVE
  CLOSED
}

enum ChurchType {
  MAIN // igreja sede
  CAMPUS
  CONGREGATION
  MISSION_POINT
}

enum RelationshipType {
  SUPERVISION // relacao padrao de cuidado/supervisao
  MENTORSHIP
  INTERIM // cobertura temporaria
}

enum CareStatus {
  PLANNED
  DONE
  CANCELED
  NO_SHOW
}

enum Confidentiality {
  NORMAL // visivel para quem tem permissao de leitura no escopo
  RESTRICTED // apenas cadeia de supervisao direta + admins
  CONFIDENTIAL // apenas autor/responsavel + permissao care.read.confidential
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PostType {
  ANNOUNCEMENT // comunicado
  NEWS // noticia
  DEVOTIONAL // devocional
  VIDEO
  DOCUMENT
  EVENT
  URGENT // aviso urgente
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AudienceType {
  ALL
  COUNTRY
  REGION
  CHURCH
  MINISTRY_ROLE
  GROUP
  USER
  SUBTREE // rede (descendentes) de um pastor
}

enum DocumentCategory {
  PASTORAL_DOCUMENT
  CERTIFICATE
  MINISTERIAL_DOCUMENT
  AUTHORIZATION
  IDENTIFICATION
  OTHER
}

enum DocumentVisibility {
  OWNER_ONLY
  SUPERVISION_CHAIN
  ADMIN_ONLY
  SCOPED
}

enum CredentialType {
  ORDINATION
  MINISTERIAL
  MISSIONARY
  TEMPORARY
  OTHER
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum TrainingKind {
  COURSE
  TRAINING
  TRACK // trilha
  WORKSHOP
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  EXPIRED
}

enum EventType {
  CARE_MEETING // acompanhamento
  MEETING // reuniao
  VISIT // visita
  COURSE
  TRAINING
  CONGRESS
  SERVICE // culto
  CONFERENCE
  TRIP // viagem
  MISSION
  OTHER
}

enum EventScopeType {
  INDIVIDUAL
  CHURCH
  REGION
  COUNTRY
  GLOBAL
}

enum EventParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
  ATTENDED
  ABSENT
}

enum NotificationType {
  CHANNEL_POST
  PASTORAL_CARE
  REQUEST
  EVENT
  DOCUMENT
  TRAINING
  SYSTEM
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// Tipo de escopo aplicado a uma permissao concedida a um usuario.
enum ScopeType {
  GLOBAL // toda a base
  COUNTRY // um pais especifico (refId = Country.id)
  REGION // uma regiao especifica (refId = Region.id)
  CHURCH // uma igreja especifica (refId = Church.id)
  SUBTREE // rede do proprio usuario (descendentes na hierarquia)
  SELF // apenas os proprios dados
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  CREATE
  UPDATE
  DELETE
  RESTORE
  READ_CONFIDENTIAL
  PERMISSION_CHANGE
  ROLE_CHANGE
  SUPERVISOR_CHANGE
  EXPORT
  ACCESS_DENIED
}

// =============================================================================
// IDENTIDADE / ACESSO
// =============================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(INVITED)

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  avatarUrl String? @map("avatar_url")
  locale    String  @default("pt-BR")
  timezone  String  @default("America/Sao_Paulo")
  phoneE164 String? @map("phone_e164")

  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  pastor        Pastor?
  roles         UserRole[]
  scopes        UserScope[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  devices       NotificationDevice[]
  notifications Notification[]

  authoredPosts     ChannelPost[]          @relation("PostAuthor")
  postReads         PostRead[]
  performedCares    PastoralCare[]         @relation("CarePerformer")
  createdCares      PastoralCare[]         @relation("CareCreator")
  requestsCreated   Request[]              @relation("RequestRequester")
  requestsAssigned  Request[]              @relation("RequestAssignee")
  requestComments   RequestTimelineEntry[]
  uploadedDocuments Document[]             @relation("DocumentUploader")
  issuedCredentials Credential[]           @relation("CredentialIssuer")
  organizedEvents   Event[]                @relation("EventOrganizer")
  eventParticipant  EventParticipant[]
  auditLogs         AuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Sessao = refresh token ativo em um dispositivo. Permite revogacao granular.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// SHA-256 do refresh token. O token puro nunca e persistido.
  tokenHash String @unique @map("token_hash")

  userAgent  String?         @map("user_agent")
  ip         String?
  deviceName String?         @map("device_name")
  platform   DevicePlatform?

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason")
  /// Rotacao: id da sessao que substituiu esta.
  replacedById  String?   @map("replaced_by_id") @db.Uuid

  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // PASTOR, SUPERVISOR, REGIONAL, NATIONAL, GLOBAL_ADMIN...
  name        String
  description String?
  /// Roles de sistema nao podem ser removidas pela UI.
  isSystem    Boolean @default(false) @map("is_system")
  /// Peso usado apenas para ordenacao/exibicao, nunca para decisao de acesso.
  rank        Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // pastor.read, care.write, channel.publish...
  resource    String // pastor, church, care, channel...
  action      String // read, write, delete, publish, manage...
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Escopo de dados concedido a um usuario.
/// permissionKeys vazio = escopo vale para todas as permissoes das roles do usuario.
/// permissionKeys preenchido = escopo restrito aquelas permissoes.
model UserScope {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @map("user_id") @db.Uuid
  type   ScopeType
  /// Country.id | Region.id | Church.id conforme `type`. Null para GLOBAL/SUBTREE/SELF.
  refId  String?   @map("ref_id") @db.Uuid

  permissionKeys String[] @default([]) @map("permission_keys")

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, type, refId])
  @@index([userId])
  @@map("user_scopes")
}

// =============================================================================
// GEOGRAFIA / ORGANIZACAO
// =============================================================================

model Country {
  id   String @id @default(uuid()) @db.Uuid
  /// ISO 3166-1 alpha-2
  code String @unique @db.Char(2)
  /// ISO 3166-1 alpha-3
  code3 String @unique @db.Char(3)

  name       String
  nativeName String? @map("native_name")
  /// E.164 country calling code, ex: "55"
  phoneCode  String  @map("phone_code")
  currency   String? @db.Char(3)

  defaultLocale   String  @default("pt-BR") @map("default_locale")
  defaultTimezone String  @default("UTC") @map("default_timezone")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  regions  Region[]
  churches Church[]
  pastors  Pastor[]

  @@index([isActive])
  @@map("countries")
}

/// Regiao administrativa. Suporta hierarquia propria (estado -> regiao -> setor).
model Region {
  id        String  @id @default(uuid()) @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid

  /// ISO 3166-2 quando aplicavel, ex: "BR-MG"
  code String
  name String
  /// Nivel hierarquico: 0 = estado/provincia, 1+ = subdivisoes.
  level    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent   Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Region[] @relation("RegionTree")
  churches Church[]
  pastors  Pastor[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([parentId])
  @@map("regions")
}

model Church {
  id     String       @id @default(uuid()) @db.Uuid
  code   String       @unique
  name   String
  type   ChurchType   @default(MAIN)
  status ChurchStatus @default(ACTIVE)
  /// Igreja sede -> campus -> congregacao. Estrutura livre.
  parentId String?    @map("parent_id") @db.Uuid

  countryId  String   @map("country_id") @db.Uuid
  regionId   String?  @map("region_id") @db.Uuid
  city       String
  address    String?
  postalCode String?  @map("postal_code")
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  phoneE164 String? @map("phone_e164")
  email     String?
  timezone  String  @default("America/Sao_Paulo")

  foundedAt       DateTime? @map("founded_at") @db.Date
  leadPastorId    String?   @unique @map("lead_pastor_id") @db.Uuid
  membersEstimate Int?      @map("members_estimate")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  country    Country  @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region     Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parent     Church?  @relation("ChurchTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children   Church[] @relation("ChurchTree")
  leadPastor Pastor?  @relation("ChurchLeadPastor", fields: [leadPastorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  pastors Pastor[] @relation("PastorChurch")
  events  Event[]

  @@index([countryId, regionId])
  @@index([status])
  @@index([parentId])
  @@index([deletedAt])
  @@map("churches")
}

/// Funcao/titulo ministerial configuravel (evita enum fixo).
model MinistryRole {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  rank        Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pastors Pastor[]

  @@map("ministry_roles")
}

// =============================================================================
// PASTOR
// =============================================================================

model Pastor {
  id String @id @default(uuid()) @db.Uuid
  /// Vinculo opcional com credencial de acesso. Nem todo pastor tem login.
  userId String? @unique @map("user_id") @db.Uuid

  firstName String @map("first_name")
  lastName  String @map("last_name")
  /// Nome pastoral / como e conhecido. Ex: "Pr. Joao Silva"
  pastoralName String  @map("pastoral_name")
  photoUrl     String? @map("photo_url")

  email        String?
  phoneE164    String? @map("phone_e164")
  whatsappE164 String? @map("whatsapp_e164")

  birthDate       DateTime?      @map("birth_date") @db.Date
  maritalStatus   MaritalStatus? @map("marital_status")
  spouseName      String?        @map("spouse_name")
  spouseBirthDate DateTime?      @map("spouse_birth_date") @db.Date

  countryId  String  @map("country_id") @db.Uuid
  regionId   String? @map("region_id") @db.Uuid
  city       String?
  address    String?
  postalCode String? @map("postal_code")

  locale   String @default("pt-BR")
  timezone String @default("America/Sao_Paulo")

  churchId       String? @map("church_id") @db.Uuid
  ministryRoleId String? @map("ministry_role_id") @db.Uuid
  /// Titulo ministerial livre (Pastor, Pastora, Bispo, Missionario...).
  ministryTitle  String? @map("ministry_title")

  joinedAt   DateTime? @map("joined_at") @db.Date
  ordainedAt DateTime? @map("ordained_at") @db.Date

  status PastorStatus @default(ACTIVE)
  /// Biografia publica (visivel no diretorio).
  biography String? @db.Text
  /// Observacoes administrativas - NUNCA expostas ao proprio pastor.
  adminNotes String? @map("admin_notes") @db.Text

  /// Cache denormalizado para indicadores/ordenacao. Mantido por PastoralCareService.
  lastCareAt DateTime? @map("last_care_at") @db.Timestamptz
  nextCareAt DateTime? @map("next_care_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  region       Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  church       Church?       @relation("PastorChurch", fields: [churchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ministryRole MinistryRole? @relation(fields: [ministryRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  leadsChurch Church? @relation("ChurchLeadPastor")

  supervisorLinks    PastoralRelationship[] @relation("RelSubordinate")
  subordinateLinks   PastoralRelationship[] @relation("RelSupervisor")
  ancestorsClosure   PastoralClosure[]      @relation("ClosureDescendant")
  descendantsClosure PastoralClosure[]      @relation("ClosureAncestor")

  cares       PastoralCare[]       @relation("CareSubject")
  requests    Request[]            @relation("RequestPastor")
  documents   Document[]           @relation("DocumentPastor")
  credentials Credential[]
  enrollments TrainingEnrollment[]
  events      EventParticipant[]   @relation("EventPastor")

  @@index([countryId, regionId])
  @@index([churchId])
  @@index([status])
  @@index([deletedAt])
  @@index([lastCareAt])
  @@map("pastors")
}

// =============================================================================
// HIERARQUIA PASTORAL
// Adjacency list + closure table. Ver docs/database.md secao "Hierarquia".
// =============================================================================

/// Aresta da hierarquia. Um pastor tem no maximo 1 supervisor ativo do tipo
/// SUPERVISION (garantido por indice unico parcial criado na migration).
model PastoralRelationship {
  id            String           @id @default(uuid()) @db.Uuid
  supervisorId  String           @map("supervisor_id") @db.Uuid
  subordinateId String           @map("subordinate_id") @db.Uuid
  type          RelationshipType @default(SUPERVISION)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  supervisor  Pastor @relation("RelSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subordinate Pastor @relation("RelSubordinate", fields: [subordinateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([supervisorId, isActive])
  @@index([subordinateId, isActive])
  @@map("pastoral_relationships")
}

/// Closure table materializada da hierarquia ativa de SUPERVISION.
/// depth 0 = self. Mantida transacionalmente por HierarchyService.
model PastoralClosure {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   Pastor @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  descendant Pastor @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@index([ancestorId, depth])
  @@map("pastoral_closure")
}

// =============================================================================
// CUIDADO PASTORAL
// =============================================================================

model PastoralCareType {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique // CONVERSATION, CALL, MEETING, VISIT...
  name     String
  icon     String?
  color    String?
  rank     Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  cares PastoralCare[]

  @@map("pastoral_care_types")
}

model PastoralCare {
  id String @id @default(uuid()) @db.Uuid
  /// Pastor cuidado.
  pastorId String @map("pastor_id") @db.Uuid
  /// Usuario responsavel pelo acompanhamento.
  performedById String @map("performed_by_id") @db.Uuid
  typeId        String @map("type_id") @db.Uuid

  occurredAt DateTime   @map("occurred_at") @db.Timestamptz
  status     CareStatus @default(DONE)

  /// Resumo curto, exibido em listas.
  summary String
  /// Anotacao completa. Sujeita ao nivel de confidencialidade.
  notes   String? @db.Text

  nextAction String?   @map("next_action")
  nextCareAt DateTime? @map("next_care_at") @db.Timestamptz

  confidentiality Confidentiality @default(NORMAL)
  durationMinutes Int?            @map("duration_minutes")
  location        String?

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  pastor      Pastor           @relation("CareSubject", fields: [pastorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  performedBy User             @relation("CarePerformer", fields: [performedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User             @relation("CareCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type        PastoralCareType @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([pastorId, occurredAt(sort: Desc)])
  @@index([performedById, occurredAt(sort: Desc)])
  @@index([nextCareAt])
  @@index([confidentiality])
  @@index([deletedAt])
  @@map("pastoral_cares")
}

// =============================================================================
// SOLICITACOES
// =============================================================================

model RequestCategory {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  name     String
  icon     String?
  /// SLA sugerido em horas, usado apenas como indicador.
  slaHours Int?    @map("sla_hours")
  rank     Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  requests Request[]

  @@map("request_categories")
}

model Request {
  id String @id @default(uuid()) @db.Uuid
  /// Numero sequencial legivel (ex: #1042).
  number     Int    @unique @default(autoincrement())
  categoryId String @map("category_id") @db.Uuid

  requesterId String  @map("requester_id") @db.Uuid
  pastorId    String? @map("pastor_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid

  subject     String
  description String @db.Text

  status          RequestStatus   @default(OPEN)
  priority        RequestPriority @default(NORMAL)
  confidentiality Confidentiality @default(NORMAL)

  dueAt      DateTime? @map("due_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  closedAt   DateTime? @map("closed_at") @db.Timestamptz
  resolution String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  category  RequestCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requester User            @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignee  User?           @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pastor    Pastor?         @relation("RequestPastor", fields: [pastorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  timeline    RequestTimelineEntry[]
  attachments Document[]             @relation("DocumentRequest")

  @@index([status, createdAt(sort: Desc)])
  @@index([requesterId])
  @@index([assigneeId, status])
  @@index([pastorId])
  @@index([deletedAt])
  @@map("requests")
}

model RequestTimelineEntry {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid

  /// COMMENT | STATUS_CHANGE | ASSIGNMENT | ATTACHMENT | SYSTEM
  kind    String
  message String? @db.Text
  /// Payload estruturado da mudanca (from/to).
  metadata Json?
  /// Nota interna nao visivel ao solicitante.
  isInternal Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([requestId, createdAt])
  @@map("request_timeline_entries")
}

// =============================================================================
// CANAL DOS PASTORES
// =============================================================================

model ChannelPost {
  id       String     @id @default(uuid()) @db.Uuid
  authorId String     @map("author_id") @db.Uuid
  type     PostType   @default(ANNOUNCEMENT)
  status   PostStatus @default(DRAFT)

  title    String
  summary  String?
  content  String  @db.Text
  coverUrl String? @map("cover_url")
  videoUrl String? @map("video_url")

  isPinned        Boolean @default(false) @map("is_pinned")
  requiresAck     Boolean @default(false) @map("requires_ack")
  allowedComments Boolean @default(false) @map("allowed_comments")

  publishedAt DateTime? @map("published_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  /// Snapshot do total de destinatarios resolvidos na publicacao.
  audienceCount Int @default(0) @map("audience_count")
  readCount     Int @default(0) @map("read_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  author      User                  @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  audiences   ChannelPostAudience[]
  reads       PostRead[]
  attachments Document[]            @relation("DocumentPost")

  @@index([status, publishedAt(sort: Desc)])
  @@index([type])
  @@index([deletedAt])
  @@map("channel_posts")
}

model ChannelPostAudience {
  id     String       @id @default(uuid()) @db.Uuid
  postId String       @map("post_id") @db.Uuid
  type   AudienceType
  /// Country.id | Region.id | Church.id | MinistryRole.id | User.id | Pastor.id (SUBTREE)
  refId  String?      @map("ref_id") @db.Uuid

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, type, refId])
  @@index([type, refId])
  @@map("channel_post_audiences")
}

model PostRead {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  readAt         DateTime  @default(now()) @map("read_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz

  post ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, userId])
  @@index([userId, readAt(sort: Desc)])
  @@map("post_reads")
}

// =============================================================================
// DOCUMENTOS
// =============================================================================

model Document {
  id       String           @id @default(uuid()) @db.Uuid
  category DocumentCategory @default(OTHER)

  title       String
  description String?

  /// Chave no storage S3/MinIO. Nunca expor URL direta - usar URL assinada.
  storageKey    String  @unique @map("storage_key")
  storageBucket String  @map("storage_bucket")
  mimeType      String  @map("mime_type")
  sizeBytes     BigInt  @map("size_bytes")
  checksum      String?

  visibility      DocumentVisibility @default(SUPERVISION_CHAIN)
  confidentiality Confidentiality    @default(NORMAL)

  issuedAt  DateTime? @map("issued_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date

  /// Dono do documento (pastor). Null = documento institucional.
  pastorId     String? @map("pastor_id") @db.Uuid
  uploadedById String  @map("uploaded_by_id") @db.Uuid
  postId       String? @map("post_id") @db.Uuid
  requestId    String? @map("request_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  pastor     Pastor?      @relation("DocumentPastor", fields: [pastorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  uploadedBy User         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  post       ChannelPost? @relation("DocumentPost", fields: [postId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  request    Request?     @relation("DocumentRequest", fields: [requestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  credential Credential?  @relation("CredentialDocument")

  @@index([pastorId])
  @@index([category])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("documents")
}

// =============================================================================
// CREDENCIAIS
// =============================================================================

model Credential {
  id       String           @id @default(uuid()) @db.Uuid
  number   String           @unique
  pastorId String           @map("pastor_id") @db.Uuid
  type     CredentialType   @default(MINISTERIAL)
  status   CredentialStatus @default(PENDING)

  issuedAt      DateTime  @map("issued_at") @db.Date
  expiresAt     DateTime? @map("expires_at") @db.Date
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason")

  /// Token opaco usado na URL publica de validacao (/credentials/verify/:token).
  /// Nao carrega dado pessoal.
  verificationToken String @unique @map("verification_token")

  issuedById String? @map("issued_by_id") @db.Uuid
  documentId String? @unique @map("document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pastor   Pastor    @relation(fields: [pastorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  issuedBy User?     @relation("CredentialIssuer", fields: [issuedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  document Document? @relation("CredentialDocument", fields: [documentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([pastorId, status])
  @@index([expiresAt])
  @@map("credentials")
}

// =============================================================================
// FORMACAO
// =============================================================================

model Training {
  id     String         @id @default(uuid()) @db.Uuid
  code   String         @unique
  kind   TrainingKind   @default(COURSE)
  status TrainingStatus @default(DRAFT)

  title       String
  summary     String?
  description String? @db.Text
  coverUrl    String? @map("cover_url")

  workloadMinutes Int?    @map("workload_minutes")
  isMandatory     Boolean @default(false) @map("is_mandatory")
  /// Percentual minimo de conclusao exigido.
  passingScore    Int     @default(100) @map("passing_score")
  language        String  @default("pt-BR")

  availableFrom DateTime? @map("available_from") @db.Timestamptz
  availableTo   DateTime? @map("available_to") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  modules     TrainingModule[]
  enrollments TrainingEnrollment[]

  @@index([status])
  @@map("trainings")
}

model TrainingModule {
  id         String @id @default(uuid()) @db.Uuid
  trainingId String @map("training_id") @db.Uuid

  title       String
  description String? @db.Text
  /// VIDEO | PDF | TEXT | LINK | QUIZ
  contentType     String  @map("content_type")
  contentUrl      String? @map("content_url")
  contentBody     String? @map("content_body") @db.Text
  durationMinutes Int?    @map("duration_minutes")
  position        Int
  isRequired      Boolean @default(true) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  training Training           @relation(fields: [trainingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progress TrainingProgress[]

  @@unique([trainingId, position])
  @@index([trainingId])
  @@map("training_modules")
}

model TrainingEnrollment {
  id         String           @id @default(uuid()) @db.Uuid
  trainingId String           @map("training_id") @db.Uuid
  pastorId   String           @map("pastor_id") @db.Uuid
  status     EnrollmentStatus @default(ENROLLED)

  enrolledAt  DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  dueAt       DateTime? @map("due_at") @db.Timestamptz
  /// 0-100, derivado de TrainingProgress.
  progressPct Int       @default(0) @map("progress_pct")
  score       Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  training    Training           @relation(fields: [trainingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pastor      Pastor             @relation(fields: [pastorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  progress    TrainingProgress[]
  certificate Certificate?

  @@unique([trainingId, pastorId])
  @@index([pastorId, status])
  @@index([dueAt])
  @@map("training_enrollments")
}

model TrainingProgress {
  id           String @id @default(uuid()) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  moduleId     String @map("module_id") @db.Uuid

  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  secondsSpent    Int       @default(0) @map("seconds_spent")
  lastPositionSec Int       @default(0) @map("last_position_sec")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  module     TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([enrollmentId, moduleId])
  @@map("training_progress")
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  enrollmentId      String   @unique @map("enrollment_id") @db.Uuid
  number            String   @unique
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz
  verificationToken String   @unique @map("verification_token")
  storageKey        String?  @map("storage_key")

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("certificates")
}

// =============================================================================
// AGENDA
// =============================================================================

model Event {
  id    String         @id @default(uuid()) @db.Uuid
  type  EventType      @default(MEETING)
  scope EventScopeType @default(INDIVIDUAL)
  /// Country.id | Region.id | Church.id conforme scope.
  scopeRefId String?   @map("scope_ref_id") @db.Uuid

  title       String
  description String? @db.Text
  location    String?
  isOnline    Boolean @default(false) @map("is_online")
  meetingUrl  String? @map("meeting_url")

  /// Sempre UTC. O cliente converte para o timezone do usuario.
  startsAt DateTime @map("starts_at") @db.Timestamptz
  endsAt   DateTime @map("ends_at") @db.Timestamptz
  allDay   Boolean  @default(false) @map("all_day")
  timezone String   @default("America/Sao_Paulo")

  churchId    String? @map("church_id") @db.Uuid
  organizerId String  @map("organizer_id") @db.Uuid
  /// RRULE (RFC 5545) para recorrencia. Null = evento unico.
  recurrenceRule String? @map("recurrence_rule")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  church       Church?            @relation(fields: [churchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organizer    User               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participants EventParticipant[]

  @@index([startsAt])
  @@index([scope, scopeRefId])
  @@index([churchId])
  @@index([deletedAt])
  @@map("events")
}

model EventParticipant {
  id       String  @id @default(uuid()) @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  pastorId String? @map("pastor_id") @db.Uuid

  status      EventParticipantStatus @default(INVITED)
  isRequired  Boolean                @default(true) @map("is_required")
  respondedAt DateTime?              @map("responded_at") @db.Timestamptz

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pastor Pastor? @relation("EventPastor", fields: [pastorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, pastorId])
  @@index([userId, status])
  @@map("event_participants")
}

// =============================================================================
// NOTIFICACOES
// =============================================================================

model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  type   NotificationType

  title String
  body  String  @db.Text
  /// Deep link interno, ex: /pastors/<id>
  link  String?

  entity   String?
  entityId String? @map("entity_id") @db.Uuid
  data     Json?

  readAt   DateTime? @map("read_at") @db.Timestamptz
  sentAt   DateTime? @map("sent_at") @db.Timestamptz
  pushSent Boolean   @default(false) @map("push_sent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDevice {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  platform DevicePlatform
  /// Token FCM.
  token      String  @unique
  deviceName String? @map("device_name")
  locale     String  @default("pt-BR")

  isActive   Boolean  @default(true) @map("is_active")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, isActive])
  @@map("notification_devices")
}

// =============================================================================
// AUDITORIA
// =============================================================================

model AuditLog {
  id     String      @id @default(uuid()) @db.Uuid
  userId String?     @map("user_id") @db.Uuid
  action AuditAction

  entity   String?
  entityId String? @map("entity_id") @db.Uuid

  /// Nunca armazenar senhas, tokens ou secrets aqui.
  metadata  Json?
  ip        String?
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
