# ==========================================================
# Plataforma Pastoral - exemplo de variaveis de ambiente
# Copie para .env e ajuste. NUNCA comite .env real.
# ==========================================================

NODE_ENV=development
APP_NAME="Plataforma Pastoral"
APP_ENV=DEV

# ---------------- API ----------------
API_PORT=3000
API_GLOBAL_PREFIX=api
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ---------------- Database ----------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/pastoral?schema=public"

# ---------------- Redis (opcional em DEV) ----------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------- JWT ----------------
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_LONG
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=plataforma-pastoral
JWT_AUDIENCE=plataforma-pastoral-clients

# ---------------- Password hashing (Argon2id) ----------------
ARGON_MEMORY_COST=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# ---------------- Storage (S3 / MinIO) ----------------
STORAGE_DRIVER=local          # local | s3
STORAGE_LOCAL_PATH=./.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pastoral
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900

# ---------------- Rate limit ----------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_TTL=300
AUTH_RATE_LIMIT_LIMIT=10

# ---------------- Jobs / Queues ----------------
QUEUES_ENABLED=false

# ---------------- Notificacoes ----------------
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------------- Observabilidade ----------------
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------------- Seed ----------------
SEED_DEFAULT_PASSWORD=Pastoral@2025
